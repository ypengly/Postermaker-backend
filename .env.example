# --- Postgres ---
POSTGRES_USER=postermaker
POSTGRES_PASSWORD=postermaker
POSTGRES_DB=postermaker
DATABASE_URL=postgresql://postermaker:postermaker@localhost:5432/postermaker

# --- Redis (rate limiting, session cache, export job queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.) ---
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=postermaker-uploads
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
S3_PUBLIC_BASE_URL=https://cdn.postermaker.app

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
STRIPE_PRICE_BUSINESS_YEARLY=price_xxx

# --- App ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
