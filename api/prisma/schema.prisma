// PosterMaker — PostgreSQL schema
// Design documents are stored as structured JSON (elements/background) on Design/DesignVersion,
// while everything that needs to be queried, filtered, or joined stays relational.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

enum ShareVisibility {
  PRIVATE
  LINK
  PUBLIC
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  designs        Design[]
  folders        Folder[]
  favorites      Favorite[]
  brandKit       BrandKit?
  uploads        Upload[]
  subscription   Subscription?
  payments       Payment[]
  teamMemberships TeamMember[]
  sharedDesigns  SharedDesign[] @relation("SharedWithUser")

  @@index([email])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  designs   Design[]
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Design {
  id          String    @id @default(cuid())
  name        String
  formatId    String
  formatName  String
  width       Int
  height      Int
  // Structured document: elements[], background{} — validated at the API layer, not the DB layer.
  document    Json
  thumbnailUrl String?
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  favorite    Boolean   @default(false)
  trashedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  versions      DesignVersion[]
  elements      DesignElement[]
  favorites     Favorite[]
  sharedDesigns SharedDesign[]

  @@index([ownerId, trashedAt])
  @@index([folderId])
}

// A denormalized, queryable index of elements for search/analytics (e.g. "find designs using this font").
// The authoritative editable state remains Design.document / DesignVersion.document.
model DesignElement {
  id        String   @id @default(cuid())
  designId  String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  type      String
  layerName String
  zIndex    Int
  createdAt DateTime @default(now())

  @@index([designId])
}

model DesignVersion {
  id        String   @id @default(cuid())
  designId  String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  document  Json
  label     String
  createdAt DateTime @default(now())

  @@index([designId, createdAt])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  categoryId  String
  category    TemplateCategory @relation(fields: [categoryId], references: [id])
  formatId    String
  document    Json
  thumbnailUrl String?
  isPro       Boolean  @default(false)
  createdAt   DateTime @default(now())

  designs Design[]

  @@index([categoryId])
}

model TemplateCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  templates Template[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId  String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, designId])
}

model BrandKit {
  id           String   @id @default(cuid())
  ownerId      String   @unique
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName String?
  contactInfo  String?
  primaryColor String?
  secondaryColor String?
  accentColor  String?
  headingFont  String?
  bodyFont     String?
  updatedAt    DateTime @updatedAt

  assets BrandAsset[]
}

model BrandAsset {
  id         String   @id @default(cuid())
  brandKitId String
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  type       String   // "logo" | "image"
  url        String
  createdAt  DateTime @default(now())

  @@index([brandKitId])
}

model Upload {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url        String
  key        String   @unique // S3 object key
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

model SharedDesign {
  id          String          @id @default(cuid())
  designId    String
  design      Design          @relation(fields: [designId], references: [id], onDelete: Cascade)
  visibility  ShareVisibility @default(LINK)
  token       String          @unique // opaque slug used in the public URL
  sharedWithUserId String?
  sharedWithUser   User?      @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  role        TeamRole        @default(VIEWER)
  createdAt   DateTime        @default(now())

  @@index([designId])
  @@index([token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  payments Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  stripeInvoiceId String?  @unique
  amountCents     Int
  currency        String   @default("usd")
  status          String
  createdAt       DateTime @default(now())

  @@index([userId])
}

// A Team is modeled implicitly as "all TeamMembers sharing an ownerId namespace" for the MVP;
// promote to a first-class Team model when multi-team-per-user ships.
model TeamMember {
  id        String   @id @default(cuid())
  teamOwnerId String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole @default(EDITOR)
  invitedAt DateTime @default(now())
  acceptedAt DateTime?

  @@unique([teamOwnerId, userId])
  @@index([teamOwnerId])
}
